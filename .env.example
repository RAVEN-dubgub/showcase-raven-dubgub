# PostgreSQL (Neon pooled URL recommended)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Public site URL (production)
NEXT_PUBLIC_SITE_URL="https://showcase-raven-dubgub.vercel.app"

# Placement lead inbox for intro + RSVP notifications
PLACEMENT_LEAD_EMAIL="wolfscotland@gmail.com"

# Preferred: Resend transactional email (free tier)
# 1. https://resend.com/signup (use wolfscotland@gmail.com)
# 2. API Keys → Create → copy re_…
# 3. Until a custom domain is verified, keep EMAIL_FROM as onboarding@resend.dev
#    (lead mail TO your Resend account email works; partner confirmation to arbitrary
#     addresses needs a verified domain OR SMTP below)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Fallback SMTP (e.g. Gmail app password) — used only when RESEND_API_KEY is unset
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Token for POST /api/privacy opt-out
PRIVACY_OPT_OUT_TOKEN="replace-with-long-random-string"

# Deep links
PM_PLATFORM_URL="https://pm-raven-dubgub.vercel.app"
COMMS_PLATFORM_URL="https://comms-raven-dubgub.vercel.app"
COHORT_PLATFORM_URL="https://site-nine-rouge-68.vercel.app"
