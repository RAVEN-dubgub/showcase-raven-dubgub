generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntroRequest {
  id            String   @id @default(cuid())
  partnerName   String
  company       String
  email         String
  studentHandles String
  message       String
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model EventRsvp {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  role      String?
  createdAt DateTime @default(now())
}

model PrivacyOptOut {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdAt DateTime @default(now())
}
